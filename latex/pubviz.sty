% A value in a padded box of fixed width, with an optional background.
% #1: color name (expands to nothing for no fill), #2: inner width or empty
% for the natural width, #3: content.
\cs_new_protected:Npn \__pv_chip:nnn #1 #2 #3
  {
    % Start a paragraph first, so a chip that opens one stays in the line.
    \mode_leave_vertical:
    \tl_set:Ne \l__pv_chipcolor_tl {#1}
    \hbox_set:Nn \l__pv_chip_box {#3}
    \dim_set:Nn \l__pv_hpad_dim { \l__pv_hpad_tl }
    \tl_if_blank:nTF {#2}
      { \dim_set:Nn \l__pv_chip_wd_dim { \box_wd:N \l__pv_chip_box + 2 \l__pv_hpad_dim } }
      { \dim_set:Nn \l__pv_chip_wd_dim { #2 + 2 \l__pv_hpad_dim } }
    \dim_set:Nn \l__pv_chip_dp_dim { \l__pv_vpad_tl }
    \dim_set:Nn \l__pv_chip_ht_dim
      { \tex_fontcharht:D \tex_font:D `0 + \l__pv_chip_dp_dim }
    \tl_if_blank:VF \l__pv_chipcolor_tl
      {
        \str_if_eq:VnT \l__pv_fill_tl { cell }
          { \exp_args:NV \cellcolor \l__pv_chipcolor_tl }
      }
    \hbox:n
      {
        \tl_if_blank:VF \l__pv_chipcolor_tl
          {
            \str_if_eq:VnF \l__pv_fill_tl { cell }
              {
                \group_begin:
                  \color { \l__pv_chipcolor_tl }
                  \tex_vrule:D
                    width \l__pv_chip_wd_dim
                    height \l__pv_chip_ht_dim
                    depth \l__pv_chip_dp_dim
                \group_end:
                \tex_kern:D - \l__pv_chip_wd_dim
              }
          }
        \hbox_to_wd:nn { \l__pv_chip_wd_dim }
          {
            \str_if_eq:VnF \l__pv_align_tl { l } { \hfil }
            \box_use:N \l__pv_chip_box
            \str_if_eq:VnF \l__pv_align_tl { r } { \hfil }
          }
      }
  }

% #1: rank (1-3), #2: inner width or empty, #3: content.
