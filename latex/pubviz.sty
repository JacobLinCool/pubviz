% pubviz.sty: result tables and one shared color theme for research papers.
%
% Write a table body as you would for tabular. pvtable finds the numbers,
% marks the best and second-best value in each column (or row), shows changes
% against a baseline, and colors everything from one accent color. The same
% accent, written to <jobname>.pubviz.json, styles the Python figures.
%
% Documentation: README.md and docs/guide.md in the repository.
% License: MIT.

\NeedsTeXFormat{LaTeX2e}[2023-11-01]
\ProvidesExplPackage{pubviz}{2026-11-21}{0.1.0}
  {Result tables and a shared color theme for research papers}

\RequirePackage{xcolor}
\RequirePackage{colortbl}
\RequirePackage{booktabs}
\RequirePackage{array}

\cs_generate_variant:Nn \regex_match:nnTF { nV }
\cs_generate_variant:Nn \regex_match:NnTF { NV }
\cs_generate_variant:Nn \regex_extract_once:NnNT { NV }
\cs_generate_variant:Nn \regex_extract_once:NnNTF { NV }
\cs_generate_variant:Nn \tl_if_head_eq_charcode:nNT { V }
\cs_generate_variant:Nn \seq_set_split_keep_spaces:Nnn { NnV }
\cs_generate_variant:Nn \seq_put_right:Nn { Ne }
\cs_generate_variant:Nn \prop_put:Nnn { Nen , Nee , NVe , NeV , NnV , Nne , NVn , NVV }
\cs_generate_variant:Nn \prop_item:Nn { Ne , NV }
\cs_generate_variant:Nn \prop_get:NnNT { Ne , NV }
\cs_generate_variant:Nn \prop_get:NnNTF { Ne , NV }
\cs_generate_variant:Nn \prop_if_in:NnTF { NV }
\cs_generate_variant:Nn \prop_if_in:NnT { NV }
\cs_generate_variant:Nn \msg_warning:nnn { nnV }
\cs_generate_variant:Nn \str_if_eq:nnTF { Vn }

% ======================================================================
% Messages
% ======================================================================

\msg_new:nnn { pubviz } { no-baseline }
  {
    The~table~asks~for~changes~(delta=#1)~but~no~row~or~column~is~marked~
    with~\iow_char:N\\pvbaseline.
  }
\msg_new:nnn { pubviz } { section-outside }
  {
    \iow_char:N\\pvsection~only~works~inside~pvtable.~In~a~plain~tabular~use~
    \iow_char:N\\pvsectionrow{<number~of~columns>}{<title>}.
  }
\msg_new:nnn { pubviz } { diagram-too-wide }
  {
    The~diagram~is~#1pt~wider~than~the~line.~Shorten~labels~or~stack~the~
    layout;~scaling~it~down~would~shrink~its~text~as~well.
  }
\msg_new:nnn { pubviz } { key-before-table }
  { \iow_char:N\\pvkey~explains~the~pvtable~before~it,~but~there~is~none~yet. }
\msg_new:nnn { pubviz } { unknown-language }
  {
    No~language~'#1'.~Built~in:~en,~zh-tw,~zh-cn,~ja,~ko.~Define~another~with~
    \iow_char:N\\pvdefinelanguage{#1}{best=...,~second=...,~...}.
  }

