    \int_zero:N \l__pv_nrows_int
    \int_zero:N \l__pv_ncols_int
    \seq_map_indexed_inline:Nn \l__pv_rows_seq
      {
        \tl_set:Ne \l__pv_row_tl { \tl_trim_spaces:n {##2} }
        % "\\[2pt]" leaves "[2pt]" at the start of the next piece.
        \int_compare:nNnT {##1} > { 1 }
          {
            \tl_if_head_eq_charcode:VNT \l__pv_row_tl [
              { \exp_after:wN \__pv_take_opt:w \l__pv_row_tl \q_stop }
          }
        \int_incr:N \l__pv_nrows_int
        \prop_put:Nen \l__pv_end_prop { \int_use:N \l__pv_nrows_int } { \\ }
        \__pv_split_row:
      }
    % The last piece was not followed by \\.
    \prop_put:Nen \l__pv_end_prop { \int_use:N \l__pv_nrows_int } { }
  }
\cs_new_protected:Npn \__pv_take_opt:w [ #1 ] #2 \q_stop
  {
    \prop_put:Nen \l__pv_end_prop { \int_use:N \l__pv_nrows_int } { \\ [#1] }
    \tl_set:Ne \l__pv_row_tl { \tl_trim_spaces:n {#2} }
  }

\cs_new_protected:Npn \__pv_split_row:
  {
    \seq_set_split_keep_spaces:NnV \l__pv_cells_seq { & } \l__pv_row_tl
    \int_set:Nn \l__pv_c_int { 1 }
    \tl_clear:N \l__pv_tmp_tl
    \seq_map_inline:Nn \l__pv_cells_seq
      {
        \tl_set:Ne \l__pv_cell_tl { \tl_trim_spaces:n {##1} }
        \int_set:Nn \l__pv_span_int { 1 }
        \regex_extract_once:NVNT \c__pv_mc_regex \l__pv_cell_tl \l__pv_match_seq
          { \int_set:Nn \l__pv_span_int { \seq_item:Nn \l__pv_match_seq { 2 } } }
        \tl_set:Ne \l__pv_key_tl { \__pv_key:nn \l__pv_nrows_int \l__pv_c_int }
        \prop_put:NVV \l__pv_cell_prop \l__pv_key_tl \l__pv_cell_tl
        \prop_put:NVe \l__pv_span_prop \l__pv_key_tl { \int_use:N \l__pv_span_int }
        \tl_put_right:Ne \l__pv_tmp_tl
          { \tl_if_empty:NF \l__pv_tmp_tl { , } \int_use:N \l__pv_c_int }
        \int_add:Nn \l__pv_c_int { \l__pv_span_int }
      }
    \prop_put:NeV \l__pv_cols_prop { \int_use:N \l__pv_nrows_int } \l__pv_tmp_tl
    \int_set:Nn \l__pv_ncols_int { \int_max:nn \l__pv_ncols_int { \l__pv_c_int - 1 } }
  }

\cs_new:Npn \__pv_cell:nn #1 #2
  { \prop_item:Ne \l__pv_cell_prop { \__pv_key:nn {#1} {#2} } }
\cs_new:Npn \__pv_kind:nn #1 #2
  { \prop_item:Ne \l__pv_kind_prop { \__pv_key:nn {#1} {#2} } }
\cs_new:Npn \__pv_val:nn #1 #2
  { \prop_item:Ne \l__pv_val_prop { \__pv_key:nn {#1} {#2} } }

% Run #2 for each start column of row #1, as ##1.
\cs_new_protected:Npn \__pv_row_cols:nn #1 #2
  {
    \prop_get:NeNT \l__pv_cols_prop { \int_eval:n {#1} } \l__pv_tmpb_tl
      { \clist_map_inline:Nn \l__pv_tmpb_tl {#2} }
  }

% Is column #2 inside a cell of row #1? The cell's start column goes to
% \l__pv_tmp_tl.
\prg_new_protected_conditional:Npnn \__pv_covering:nn #1 #2 { T , TF }
  {
    \tl_clear:N \l__pv_tmp_tl
    \prop_get:NeNT \l__pv_cols_prop { \int_eval:n {#1} } \l__pv_tmpb_tl
      {
        \clist_map_inline:Nn \l__pv_tmpb_tl
          {
            \int_compare:nT
              {
                ##1 <= #2 <
                ##1 + \prop_item:Ne \l__pv_span_prop { \__pv_key:nn {#1} {##1} }
              }
              { \tl_set:Nn \l__pv_tmp_tl {##1} \clist_map_break: }
          }
      }
    \tl_if_empty:NTF \l__pv_tmp_tl { \prg_return_false: } { \prg_return_true: }
  }

% ---- 2. what each cell is
\cs_new_protected:Npn \__pv_classify:
  {
    \prop_clear:N \l__pv_kind_prop
    \prop_clear:N \l__pv_val_prop
    \prop_clear:N \l__pv_dec_prop
    % Header rows: everything above the first \midrule or \hline after row 1.
    \str_if_eq:VnTF \l__pv_header_tl { auto }
      {
        \int_zero:N \l__pv_hrows_int
        \int_step_inline:nnn { 2 } { \l__pv_nrows_int }
          {
            \int_compare:nNnT \l__pv_hrows_int = { 0 }
              {
                \tl_set:Ne \l__pv_tmp_tl { \__pv_cell:nn {##1} { 1 } }
                \tl_if_in:NnT \l__pv_tmp_tl { \midrule }
                  { \int_set:Nn \l__pv_hrows_int { ##1 - 1 } }
                \tl_if_in:NnT \l__pv_tmp_tl { \hline }
                  { \int_set:Nn \l__pv_hrows_int { ##1 - 1 } }
              }
          }
      }
      { \int_set:Nn \l__pv_hrows_int { \l__pv_header_tl } }
    \int_step_inline:nn { \l__pv_nrows_int }
      {
        \__pv_row_cols:nn {##1}
          {
            \tl_set:Ne \l__pv_key_tl { \__pv_key:nn {##1} {####1} }
            \tl_set:Ne \l__pv_cell_tl { \prop_item:NV \l__pv_cell_prop \l__pv_key_tl }
            \__pv_classify_cell:nn {##1} {####1}
          }
      }
  }

\cs_new_protected:Npn \__pv_classify_cell:nn #1 #2
  {
    \tl_if_in:NnTF \l__pv_cell_tl { \pvsection }
      { \prop_put:NVn \l__pv_kind_prop \l__pv_key_tl { s } }
      {
        \int_compare:nNnTF {#1} > \l__pv_hrows_int
          {
            \int_compare:nNnTF {#2} > \l__pv_label_cols_int
              { \__pv_classify_value: }
              { \prop_put:NVn \l__pv_kind_prop \l__pv_key_tl { l } }
          }
          { \prop_put:NVn \l__pv_kind_prop \l__pv_key_tl { h } }
      }
  }
\cs_new_protected:Npn \__pv_classify_value:
  {
    \regex_match:NVTF \c__pv_missing_regex \l__pv_cell_tl
      {
        \prop_put:NVn \l__pv_kind_prop \l__pv_key_tl { m }
        \bool_gset_true:N \g__pv_key_missing_bool
      }
      {
        \regex_extract_once:NVNTF \c__pv_number_regex \l__pv_cell_tl \l__pv_match_seq
          {
            \tl_set:Ne \l__pv_tmp_tl { \seq_item:Nn \l__pv_match_seq { 4 } }
            \regex_match:NVTF \c__pv_tail_regex \l__pv_tmp_tl
              {
                \prop_put:NVn \l__pv_kind_prop \l__pv_key_tl { n }
                \tl_set:Ne \l__pv_tmp_tl { \seq_item:Nn \l__pv_match_seq { 3 } }
                \prop_put:NVe \l__pv_val_prop \l__pv_key_tl
                  { \fp_eval:n { \seq_item:Nn \l__pv_match_seq { 2 } ( \l__pv_tmp_tl ) } }
                \__pv_decimals:V \l__pv_tmp_tl
                \prop_put:NVe \l__pv_dec_prop \l__pv_key_tl { \int_use:N \l__pv_dec_int }
              }
              { \prop_put:NVn \l__pv_kind_prop \l__pv_key_tl { t } }
          }
          { \prop_put:NVn \l__pv_kind_prop \l__pv_key_tl { t } }
      }
  }

\cs_new_protected:Npn \__pv_decimals:n #1
  {
    \tl_if_in:nnTF {#1} { . }
      { \__pv_decimals_aux:w #1 \q_stop }
      { \int_zero:N \l__pv_dec_int }
  }
\cs_new_protected:Npn \__pv_decimals_aux:w #1 . #2 \q_stop
  { \int_set:Nn \l__pv_dec_int { \tl_count:n {#2} } }
\cs_generate_variant:Nn \__pv_decimals:n { V }

% Methods and metrics.
%   by=column: each column is a metric, named in the header; each row is a
%              method, named in the label column.
%   by=row:    each row is a metric, named in the label column; each column
%              is a method, named in the header.
% An arrow (\uparrow, \downarrow, \pvup, \pvdown) where a metric is named sets
% its direction. \pvours, \pvbaseline and \pvnorank where a method is named
% mark that method.
\cs_new_protected:Npn \__pv_markers:
  {
    \prop_clear:N \l__pv_flag_prop
    \prop_clear:N \l__pv_dirs_prop
    \int_step_inline:nn { \l__pv_ncols_int }
      {
        \tl_clear:N \l__pv_dir_tl
        \tl_clear:N \l__pv_flags_tl
        \int_step_inline:nn { \l__pv_hrows_int }
          {
            \__pv_covering:nnT {####1} {##1}
              {
                \tl_set:Ne \l__pv_cell_tl { \__pv_cell:nn {####1} { \l__pv_tmp_tl } }
                \__pv_scan:N \l__pv_cell_tl
              }
          }
        \str_if_eq:VnTF \l__pv_by_tl { column }
          {
            \prop_put:Nne \l__pv_dirs_prop {##1}
              { \tl_if_empty:NTF \l__pv_dir_tl { \l__pv_better_tl } { \l__pv_dir_tl } }
          }
          { \prop_put:NnV \l__pv_flag_prop {##1} \l__pv_flags_tl }
      }
    \int_step_inline:nnn { \l__pv_hrows_int + 1 } { \l__pv_nrows_int }
      {
        \tl_clear:N \l__pv_dir_tl
        \tl_clear:N \l__pv_flags_tl
        \int_step_inline:nn { \l__pv_label_cols_int }
          {
            \tl_set:Ne \l__pv_cell_tl { \__pv_cell:nn {##1} {####1} }
            \__pv_scan:N \l__pv_cell_tl
          }
        \str_if_eq:VnTF \l__pv_by_tl { row }
          {
            \prop_put:Nne \l__pv_dirs_prop {##1}
              { \tl_if_empty:NTF \l__pv_dir_tl { \l__pv_better_tl } { \l__pv_dir_tl } }
          }
          { \prop_put:NnV \l__pv_flag_prop {##1} \l__pv_flags_tl }
      }
  }
\cs_new_protected:Npn \__pv_scan:N #1
  {
    \tl_if_in:NnT #1 { \downarrow } { \tl_set:Nn \l__pv_dir_tl { lower } }
    \tl_if_in:NnT #1 { \pvdown } { \tl_set:Nn \l__pv_dir_tl { lower } }
    \tl_if_in:NnT #1 { \uparrow } { \tl_set:Nn \l__pv_dir_tl { higher } }
    \tl_if_in:NnT #1 { \pvup } { \tl_set:Nn \l__pv_dir_tl { higher } }
    \tl_if_in:NnT #1 { \pvours } { \tl_put_right:Nn \l__pv_flags_tl { o } }
    \tl_if_in:NnT #1 { \pvbaseline } { \tl_put_right:Nn \l__pv_flags_tl { b } }
    \tl_if_in:NnT #1 { \pvnorank } { \tl_put_right:Nn \l__pv_flags_tl { x } }
  }

\cs_new:Npn \__pv_entity:nn #1 #2
  { \str_if_eq:VnTF \l__pv_by_tl { column } {#1} {#2} }
\cs_new:Npn \__pv_ngroups:
  { \str_if_eq:VnTF \l__pv_by_tl { column } { \l__pv_ncols_int } { \l__pv_nrows_int } }
\cs_new:Npn \__pv_first_group:
  {
    \str_if_eq:VnTF \l__pv_by_tl { column }
      { \l__pv_label_cols_int + 1 } { \l__pv_hrows_int + 1 }
  }
\prg_new_protected_conditional:Npnn \__pv_flag:nn #1 #2 { T , F , TF }
  {
    \tl_set:Ne \l__pv_tmp_tl { \prop_item:Ne \l__pv_flag_prop {#1} }
    \tl_if_in:NnTF \l__pv_tmp_tl {#2} { \prg_return_true: } { \prg_return_false: }
  }

% Run #2 for each number in group #1 that takes part in ranking (not marked
% \pvnorank), with its row and column as ##1 and ##2.
\cs_new_protected:Npn \__pv_map_body:nn #1 #2 { }
\cs_new_protected:Npn \__pv_map_group:nn #1 #2
  {
    \cs_set_protected:Npn \__pv_map_body:nn ##1 ##2 {#2}
    \str_if_eq:VnTF \l__pv_by_tl { column }
      {
        \int_step_inline:nnn { \l__pv_hrows_int + 1 } { \l__pv_nrows_int }
          { \__pv_map_cell:nn {##1} {#1} }
      }
      {
        \int_step_inline:nnn { \l__pv_label_cols_int + 1 } { \l__pv_ncols_int }
          { \__pv_map_cell:nn {#1} {##1} }
      }
  }
\bool_new:N \l__pv_all_bool
\cs_new_protected:Npn \__pv_map_cell:nn #1 #2
  {
    \str_if_eq:eeT { \__pv_kind:nn {#1} {#2} } { n }
      {
        \bool_if:NTF \l__pv_all_bool
          { \__pv_map_body:nn {#1} {#2} }
          {
            \__pv_flag:nnF { \__pv_entity:nn {#1} {#2} } { x }
              { \__pv_map_body:nn {#1} {#2} }
          }
      }
  }
% The same over every number, \pvnorank included.
\cs_new_protected:Npn \__pv_map_all:nn #1 #2
  {
    \bool_set_true:N \l__pv_all_bool
    \__pv_map_group:nn {#1} {#2}
    \bool_set_false:N \l__pv_all_bool
  }

% ---- 3. ranks
% shared: values tied for best are all best and the next value is third
%         ("1, 1, 3"), the usual sports ranking.
% dense:  the next value after a tie is second ("1, 1, 2").
\cs_new_protected:Npn \__pv_rank:
  {
    \prop_clear:N \l__pv_rank_prop
    \int_compare:nNnT \l__pv_ranks_int > { 0 }
      {
        \int_step_inline:nnn { \__pv_first_group: } { \__pv_ngroups: }
          {
            \tl_set:Ne \l__pv_dir_tl { \prop_item:Nn \l__pv_dirs_prop {##1} }
            \seq_clear:N \l__pv_vals_seq
            \__pv_map_group:nn {##1}
              { \seq_put_right:Ne \l__pv_vals_seq { \__pv_val:nn {####1} {####2} } }
            \seq_set_eq:NN \l__pv_distinct_seq \l__pv_vals_seq
            \seq_remove_duplicates:N \l__pv_distinct_seq
            \str_if_eq:VnT \l__pv_ties_tl { dense }
              { \seq_set_eq:NN \l__pv_vals_seq \l__pv_distinct_seq }
            % Nothing to mark when every value in the group is the same.
            \int_compare:nNnT { \seq_count:N \l__pv_distinct_seq } > { 1 }
              {
                \prop_clear:N \l__pv_marked_prop
                \__pv_map_group:nn {##1} { \__pv_rank_cell:nn {####1} {####2} }
                \__pv_key_note_group:
              }
          }
      }
  }
\cs_new_protected:Npn \__pv_rank_cell:nn #1 #2
  {
    \fp_set:Nn \l__pv_v_fp { \__pv_val:nn {#1} {#2} }
    \int_set:Nn \l__pv_rank_int { 1 }
    \str_if_eq:VnTF \l__pv_dir_tl { lower }
      {
        \seq_map_inline:Nn \l__pv_vals_seq
          { \fp_compare:nNnT {##1} < \l__pv_v_fp { \int_incr:N \l__pv_rank_int } }
      }
      {
        \seq_map_inline:Nn \l__pv_vals_seq
          { \fp_compare:nNnT {##1} > \l__pv_v_fp { \int_incr:N \l__pv_rank_int } }
      }
    \int_compare:nNnF \l__pv_rank_int > { \int_min:nn { \l__pv_ranks_int } { 3 } }
      {
        \prop_put:Nee \l__pv_rank_prop { \__pv_key:nn {#1} {#2} }
          { \int_use:N \l__pv_rank_int }
        \prop_put:Nee \l__pv_marked_prop { \int_use:N \l__pv_rank_int } { }
      }
    \bool_if:NT \l__pv_debug_bool
      {
        \iow_log:e
          {
            pubviz~rank:~table~\int_use:N \g__pv_table_int \c_space_tl
            row~#1~col~#2~value~\fp_use:N \l__pv_v_fp
            \c_space_tl rank~\int_use:N \l__pv_rank_int
            \c_space_tl (\l__pv_dir_tl)
          }
      }
  }

% ---- 4. changes against the baseline
\cs_new_protected:Npn \__pv_deltas:
  {
    \prop_clear:N \l__pv_dtxt_prop
    \str_if_eq:VnF \l__pv_delta_tl { none }
      {
        \int_zero:N \l__pv_base_int
        \prop_map_inline:Nn \l__pv_flag_prop
          {
            \tl_if_in:nnT {##2} { b }
              {
                \int_compare:nNnT \l__pv_base_int = { 0 }
                  { \int_set:Nn \l__pv_base_int {##1} }
              }
          }
        \int_compare:nNnTF \l__pv_base_int = { 0 }
          { \msg_warning:nnV { pubviz } { no-baseline } \l__pv_delta_tl }
          {
            \int_step_inline:nnn { \__pv_first_group: } { \__pv_ngroups: }
              {
                \tl_set:Ne \l__pv_dir_tl { \prop_item:Nn \l__pv_dirs_prop {##1} }
                \tl_set:Ne \l__pv_tmpb_tl
                  {
                    \str_if_eq:VnTF \l__pv_by_tl { column }
                      { \__pv_key:nn \l__pv_base_int {##1} }
                      { \__pv_key:nn {##1} \l__pv_base_int }
                  }
                \str_if_eq:eeT { \prop_item:NV \l__pv_kind_prop \l__pv_tmpb_tl } { n }
                  {
                    \fp_set:Nn \l__pv_w_fp { \prop_item:NV \l__pv_val_prop \l__pv_tmpb_tl }
                    \__pv_map_all:nn {##1}
                      {
                        \int_compare:nNnF
                          { \__pv_entity:nn {####1} {####2} } = \l__pv_base_int
                          { \__pv_delta_cell:nn {####1} {####2} }
                      }
                  }
              }
          }
      }
  }

\cs_new_protected:Npn \__pv_delta_cell:nn #1 #2
  {
    \fp_set:Nn \l__pv_v_fp { \__pv_val:nn {#1} {#2} }
    \str_if_eq:VnTF \l__pv_delta_tl { relative }
      {
        \fp_compare:nNnTF \l__pv_w_fp = { 0 }
          { \fp_set:Nn \l__pv_x_fp { nan } }
          {
            \fp_set:Nn \l__pv_x_fp
              { ( \l__pv_v_fp - \l__pv_w_fp ) / abs ( \l__pv_w_fp ) * 100 }
            \int_set_eq:NN \l__pv_dec_int \l__pv_delta_digits_int
          }
      }
      {
        \fp_set:Nn \l__pv_x_fp { \l__pv_v_fp - \l__pv_w_fp }
        \int_set:Nn \l__pv_dec_int
          {
            \int_max:nn
              { \prop_item:Ne \l__pv_dec_prop { \__pv_key:nn {#1} {#2} } }
              { \prop_item:NV \l__pv_dec_prop \l__pv_tmpb_tl }
          }
      }
    \fp_if_nan:nF { \l__pv_x_fp } { \__pv_delta_store:nn {#1} {#2} }
  }
% The minus of a change: the math minus, which every math font has (text
% fonts such as newtxtext lack \textminus, and LaTeX then borrows another
% family) and which turns bold with the best value's \boldmath.
\cs_new_protected:Npn \__pv_minus: { \ensuremath { - } }
\cs_new_protected:Npn \__pv_delta_store:nn #1 #2
  {
    \fp_set:Nn \l__pv_x_fp { round ( \l__pv_x_fp , \l__pv_dec_int ) }
    \int_set:Nn \l__pv_sgn_int { \fp_eval:n { sign ( \l__pv_x_fp ) } }
    \str_if_eq:VnT \l__pv_dir_tl { lower }
      { \int_set:Nn \l__pv_sgn_int { - \l__pv_sgn_int } }
    \tl_set:Ne \l__pv_num_tl
      {
        \fp_compare:nNnTF \l__pv_x_fp > { 0 } { + }
          { \fp_compare:nNnT \l__pv_x_fp < { 0 } { \exp_not:N \__pv_minus: } }
        \__pv_fixed:nn { abs ( \l__pv_x_fp ) } { \l__pv_dec_int }
        \str_if_eq:VnT \l__pv_delta_tl { relative } { \exp_not:N \% }
      }
    \prop_put:Nee \l__pv_dtxt_prop { \__pv_key:nn {#1} {#2} }
      { { \int_use:N \l__pv_sgn_int } { \exp_not:V \l__pv_num_tl } }
  }

% #1 written with exactly #2 decimals (expandable).
\cs_new:Npn \__pv_fixed:nn #1 #2
  {
    \exp_args:Nee \__pv_fixed_aux:nn
      { \fp_eval:n { round ( #1 , #2 ) } } { \int_eval:n {#2} }
  }
\cs_new:Npn \__pv_fixed_aux:nn #1 #2 { \__pv_fixed_split:w #1 . . \q_mark #2 \q_stop }
% "2.3" + ". ." splits as 2 | 3 | .  and "2" + ". ." as 2 | (empty) | (empty).
\cs_new:Npn \__pv_fixed_split:w #1 . #2 . #3 \q_mark #4 \q_stop
  {
    #1
    \int_compare:nNnT {#4} > { 0 }
      { . #2 \prg_replicate:nn { #4 - \str_count:n {#2} } { 0 } }
  }

% ---- 5. heat
\cs_new_protected:Npn \__pv_heat:
  {
    \prop_clear:N \l__pv_heat_prop
    \str_if_eq:VnF \l__pv_heat_tl { none }
      {
        \str_if_eq:VnTF \l__pv_heat_tl { table }
          {
            \fp_set:Nn \l__pv_min_fp { inf }
            \fp_set:Nn \l__pv_max_fp { -inf }
            \int_step_inline:nnn { \__pv_first_group: } { \__pv_ngroups: }
              { \__pv_map_group:nn {##1} { \__pv_minmax:nn {####1} {####2} } }
            \tl_set_eq:NN \l__pv_dir_tl \l__pv_better_tl
            \int_step_inline:nnn { \__pv_first_group: } { \__pv_ngroups: }
              { \__pv_map_group:nn {##1} { \__pv_heat_cell:nn {####1} {####2} } }
          }
          {
            \int_step_inline:nnn { \__pv_first_group: } { \__pv_ngroups: }
              {
                \fp_set:Nn \l__pv_min_fp { inf }
                \fp_set:Nn \l__pv_max_fp { -inf }
                \__pv_map_group:nn {##1} { \__pv_minmax:nn {####1} {####2} }
                \tl_set:Ne \l__pv_dir_tl { \prop_item:Nn \l__pv_dirs_prop {##1} }
                \__pv_map_group:nn {##1} { \__pv_heat_cell:nn {####1} {####2} }
              }
          }
      }
  }
\cs_new_protected:Npn \__pv_minmax:nn #1 #2
  {
    \fp_set:Nn \l__pv_min_fp { min ( \l__pv_min_fp , \__pv_val:nn {#1} {#2} ) }
    \fp_set:Nn \l__pv_max_fp { max ( \l__pv_max_fp , \__pv_val:nn {#1} {#2} ) }
  }
\cs_new_protected:Npn \__pv_heat_cell:nn #1 #2
  {
    \fp_compare:nNnF \l__pv_max_fp = \l__pv_min_fp
      {
        \fp_set:Nn \l__pv_v_fp
          {
            ( \__pv_val:nn {#1} {#2} - \l__pv_min_fp )
            / ( \l__pv_max_fp - \l__pv_min_fp )
          }
        \str_if_eq:VnT \l__pv_dir_tl { lower }
          { \fp_set:Nn \l__pv_v_fp { 1 - \l__pv_v_fp } }
        \prop_put:Nee \l__pv_heat_prop { \__pv_key:nn {#1} {#2} }
          { \fp_eval:n { round ( 8 * \l__pv_v_fp ) } }
      }
  }

% ---- 6. formatted content and the widest value per column
\cs_new_protected:Npn \__pv_measure:
  {
    \prop_clear:N \l__pv_wd_prop
    \prop_map_inline:Nn \l__pv_kind_prop
      {
        \bool_lazy_or:nnT { \str_if_eq_p:nn {##2} { n } } { \str_if_eq_p:nn {##2} { m } }
          {
            \__pv_format:n {##1}
            \hbox_set:Nn \l__pv_tmp_box { \tl_use:N \l__pv_tmp_tl }
            \__pv_col_of:w ##1 \q_stop
            \prop_get:NVNTF \l__pv_wd_prop \l__pv_cell_tl \l__pv_tmpb_tl
              {
                \dim_compare:nNnT { \box_wd:N \l__pv_tmp_box } > { \l__pv_tmpb_tl }
                  {
                    \prop_put:NVe \l__pv_wd_prop \l__pv_cell_tl
                      { \dim_use:N \box_wd:N \l__pv_tmp_box }
                  }
              }
              {
                \prop_put:NVe \l__pv_wd_prop \l__pv_cell_tl
                  { \dim_use:N \box_wd:N \l__pv_tmp_box }
              }
          }
      }
  }
\cs_new_protected:Npn \__pv_col_of:w #1 , #2 \q_stop { \tl_set:Nn \l__pv_cell_tl {#2} }

% Cell "r,c" with rank font and change, into \l__pv_tmp_tl.
\cs_new_protected:Npn \__pv_format:n #1
  {
    \str_if_eq:eeTF { \prop_item:Nn \l__pv_kind_prop {#1} } { m }
      { \tl_set:Nn \l__pv_tmp_tl { \__pv_na: } }
      {
        \tl_set:Ne \l__pv_tmp_tl { \prop_item:Nn \l__pv_cell_prop {#1} }
        \prop_get:NnNT \l__pv_dtxt_prop {#1} \l__pv_tmpb_tl
          {
            \str_if_eq:VnTF \l__pv_show_tl { delta }
              {
                \tl_set:Ne \l__pv_tmp_tl
                  { \exp_not:N \__pv_delta_text:nn \exp_not:V \l__pv_tmpb_tl }
              }
              {
                \tl_put_right:Ne \l__pv_tmp_tl
                  { \exp_not:N \, \exp_not:N \__pv_delta_small:nn \exp_not:V \l__pv_tmpb_tl }
              }
          }
        \prop_get:NnNT \l__pv_rank_prop {#1} \l__pv_tmpb_tl
          {
            \tl_set:Ne \l__pv_tmp_tl
              {
                \exp_not:N \__pv_rank_font:nn
                  { \l__pv_tmpb_tl } { \exp_not:V \l__pv_tmp_tl }
              }
          }
      }
  }

% ---- 7. write the rows back out
\cs_new_protected:Npn \__pv_emit:
  {
    \tl_clear:N \l__pv_out_tl
    \int_step_inline:nn { \l__pv_nrows_int }
      {
        \__pv_row_cols:nn {##1}
          {
            \int_compare:nNnF {####1} = { 1 } { \tl_put_right:Nn \l__pv_out_tl { & } }
            \tl_set:Ne \l__pv_key_tl { \__pv_key:nn {##1} {####1} }
            \str_case_e:nnF { \prop_item:NV \l__pv_kind_prop \l__pv_key_tl }
              {
                { n } { \__pv_emit_value:n {####1} }
                { m } { \__pv_emit_value:n {####1} }
              }
              {
                \tl_put_right:Ne \l__pv_out_tl
                  { \prop_item:NV \l__pv_cell_prop \l__pv_key_tl }
              }
          }
        \tl_put_right:Ne \l__pv_out_tl { \prop_item:Ne \l__pv_end_prop {##1} }
      }
    \bool_if:NT \l__pv_debug_bool
      { \iow_log:e { pubviz~table:~\exp_not:V \l__pv_out_tl } }
  }
\cs_new_protected:Npn \__pv_emit_value:n #1
  {
    \exp_args:NV \__pv_format:n \l__pv_key_tl
    \tl_set:Ne \l__pv_tmpb_tl
      {
        \bool_if:nT { \__pv_fills_on_p: }
          {
            \prop_if_in:NVTF \l__pv_heat_prop \l__pv_key_tl
              { pv-heat- \prop_item:NV \l__pv_heat_prop \l__pv_key_tl }
              {
                \prop_if_in:NVT \l__pv_rank_prop \l__pv_key_tl
                  { pv-fill- \prop_item:NV \l__pv_rank_prop \l__pv_key_tl }
              }
          }
      }
    \tl_put_right:Ne \l__pv_out_tl
      {
        \exp_not:N \__pv_chip:nnn
          { \l__pv_tmpb_tl }
          { \prop_item:Ne \l__pv_wd_prop { \int_eval:n {#1} } }
          { \exp_not:V \l__pv_tmp_tl }
      }
  }

% ---- 8. the key under a table
% \pvkey after a pvtable explains each mark that table shows by showing the
% mark itself: "Best" sits in the best fill, "better" in the color of a change
% that helps. The caption is then free to state the finding. Each table
% records what its key needs; \pvkey replays the table's options, so the key
% follows its mode, fill and colors.
\tl_new:N \g__pv_key_opts_tl
\clist_new:N \g__pv_key_ranks_clist     % ranks that got a mark
\bool_new:N \g__pv_key_table_bool       % a pvtable came before
\bool_new:N \g__pv_key_missing_bool
\bool_new:N \g__pv_key_delta_bool
\bool_new:N \g__pv_key_heat_bool
\bool_new:N \g__pv_key_ours_bool        % a method is marked \pvours
\prop_new:N \l__pv_marked_prop          % the ranks one group marked
\seq_new:N \l__pv_key_lines_seq
\tl_new:N \l__pv_key_line_tl
\tl_new:N \l__pv_key_each_tl

\cs_new_protected:Npn \__pv_key_reset:n #1
  {
    \tl_gset:Nn \g__pv_key_opts_tl {#1}
    \clist_gclear:N \g__pv_key_ranks_clist
    \bool_gset_true:N \g__pv_key_table_bool
    \bool_gset_false:N \g__pv_key_missing_bool
    \bool_gset_false:N \g__pv_key_delta_bool
    \bool_gset_false:N \g__pv_key_heat_bool
    \bool_gset_false:N \g__pv_key_ours_bool
  }
% After the markers are read: whether a method is marked as the paper's own.
\cs_new_protected:Npn \__pv_key_note_ours:
  {
    \prop_map_inline:Nn \l__pv_flag_prop
      { \tl_if_in:nnT {##2} { o } { \bool_gset_true:N \g__pv_key_ours_bool } }
  }
% After one group is ranked: which ranks it marked.
\cs_new_protected:Npn \__pv_key_note_group:
  {
    \prop_map_inline:Nn \l__pv_marked_prop
      {
        \clist_if_in:NnF \g__pv_key_ranks_clist {##1}
          { \clist_gput_right:Nn \g__pv_key_ranks_clist {##1} }
      }
  }

\NewDocumentCommand \pvkey { O{} }
  {
    \bool_if:NF \g__pv_key_table_bool { \msg_error:nn { pubviz } { key-before-table } }
    \par
    \group_begin:
      \__pv_apply:V \g__pv_key_opts_tl
      \keys_set:nn { pubviz / key } {#1}
      \__pv_key_build:
      \bool_if:NT \l__pv_debug_bool
        {
          \iow_log:e
            {
              pubviz~key:~table~\int_use:N \g__pv_table_int :~
              \seq_use:Nn \l__pv_key_lines_seq { ~|~ }
            }
        }
      \seq_if_empty:NF \l__pv_key_lines_seq
        {
          \smallskip
          \footnotesize
          \skip_set:Nn \baselineskip { 1.5 \baselineskip }
          \dim_zero:N \parindent
          \centering
          \seq_map_inline:Nn \l__pv_key_lines_seq { \mode_leave_vertical: ##1 \par }
        }
    \group_end:
  }

% Fills are drawn for ranks unless the table shades by value instead.
\prg_new_conditional:Npnn \__pv_key_fills: { p , TF }
  {
    \bool_if:nTF { \__pv_fills_on_p: && ! \g__pv_key_heat_bool }
      { \prg_return_true: } { \prg_return_false: }
  }
% A rank gets a line only when its mark shows in the table.
\prg_new_protected_conditional:Npnn \__pv_key_visible:n #1 { T }
  {
    \bool_lazy_any:nTF
      {
        { \__pv_key_fills_p: && \int_compare_p:nNn {#1} < { 4 } }
        { \int_compare_p:nNn {#1} = { 1 } && \l__pv_bold_best_bool }
        { \int_compare_p:nNn {#1} = { 2 } && \__pv_underline_p: }
      }
      { \prg_return_true: } { \prg_return_false: }
  }
% #1: rank, #2: words, set with the mark of that rank.
\cs_new_protected:Npn \__pv_key_cue:nn #1 #2
  {
    \__pv_key_fills:TF
      {
        \group_begin:
          % A filled box, also for tables that fill the whole cell.
          \tl_set:Nn \l__pv_fill_tl { chip }
          \tl_set:Nn \l__pv_align_tl { c }
          \__pv_ranked:nnn {#1} { } {#2}
        \group_end:
      }
      { \__pv_rank_font:nn {#1} {#2} }
  }
\cs_new_protected:Npn \__pv_key_ramp:
  {
    \clist_map_inline:nn { 0 , 2 , 4 , 6 , 8 }
      {
        \group_begin:
          \color { pv-heat-##1 }
          \tex_vrule:D width 0.8em height 0.75em depth 0.15em
        \group_end:
      }
  }

\cs_new_protected:Npn \__pv_key_build:
  {
    \seq_clear:N \l__pv_key_lines_seq
    \tl_set:Ne \l__pv_key_each_tl
      {
        \str_if_eq:VnTF \l__pv_by_tl { column }
          { \exp_not:V \l__pv_kw_each_column_tl } { \exp_not:V \l__pv_kw_each_row_tl }
      }
    \clist_map_inline:nn { 1 , 2 , 3 }
      {
        \clist_if_in:NnT \g__pv_key_ranks_clist {##1}
          { \__pv_key_visible:nT {##1} { \__pv_key_rank_line:n {##1} } }
      }
    \bool_if:NT \g__pv_key_delta_bool { \__pv_key_delta_line: }
    \bool_if:nT { \g__pv_key_heat_bool && \__pv_fills_on_p: } { \__pv_key_heat_line: }
    % The paper's own method gets a line only when the words for it are set:
    % a row named "Ours" explains itself.
    \bool_lazy_and:nnT
      { \g__pv_key_ours_bool }
      { ! \tl_if_empty_p:N \l__pv_key_ours_tl && ! \tl_if_empty_p:N \l__pv_ours_style_tl }
      {
        \seq_put_right:Ne \l__pv_key_lines_seq
          { \exp_not:N \__pv_key_ours:n { \exp_not:V \l__pv_key_ours_tl } }
      }
    \bool_if:NT \g__pv_key_missing_bool
      {
        \seq_put_right:Ne \l__pv_key_lines_seq
          { \exp_not:N \__pv_na: \c_space_tl \exp_not:V \l__pv_key_missing_tl }
      }
  }
% A rank's line names its mark and what it is compared within. It says
% nothing the table shows itself: the arrows say which way is better, and
% tied values carry the same mark.
\cs_new_protected:Npn \__pv_key_rank_line:n #1
  {
    \seq_put_right:Ne \l__pv_key_lines_seq
      {
        \exp_not:N \__pv_key_cue:nn {#1}
          {
            \exp_not:v
              { l__pv_key_ \int_case:nn {#1} { {1}{best} {2}{second} {3}{third} } _tl }
          }
        \c_space_tl \exp_not:V \l__pv_key_each_tl
      }
  }
\cs_new_protected:Npn \__pv_key_delta_line:
  {
    \tl_set:Ne \l__pv_key_line_tl
      {
        \str_if_eq:VnTF \l__pv_show_tl { delta }
          { \exp_not:V \l__pv_kw_signed_tl } { \exp_not:V \l__pv_kw_small_tl }
        \exp_not:V \l__pv_kw_colon_tl \__pv_kw_sep:
      }
    \str_if_eq:VnTF \l__pv_delta_tl { relative }
      { \__pv_key_join:VVV \l__pv_kw_against_rel_tl \l__pv_key_baseline_tl \l__pv_kw_after_rel_tl }
      { \__pv_key_join:VVV \l__pv_kw_against_tl \l__pv_key_baseline_tl \l__pv_kw_after_tl }
    % Only color tells better from worse; in grey the sign and arrow do.
    \str_if_eq:VnT \l__pv_mode_tl { color }
      {
        \tl_put_right:Ne \l__pv_key_line_tl
          {
            \exp_not:V \l__pv_kw_comma_tl \__pv_kw_sep:
            \exp_not:N \__pv_delta_text:nn { 1 } { \exp_not:V \l__pv_kw_better_tl }
            \__pv_kw_sep: \exp_not:V \l__pv_kw_or_tl \__pv_kw_sep:
            \exp_not:N \__pv_delta_text:nn { -1 } { \exp_not:V \l__pv_kw_worse_tl }
          }
      }
    \seq_put_right:NV \l__pv_key_lines_seq \l__pv_key_line_tl
  }
% Append the non-empty parts of a phrase, with the language's space between.
\cs_new_protected:Npn \__pv_key_join:nnn #1 #2 #3
  {
    \tl_clear:N \l__pv_key_join_tl
    \tl_map_inline:nn { {#1} {#2} {#3} }
      {
        \tl_if_blank:nF {##1}
          {
            \tl_if_empty:NF \l__pv_key_join_tl
              { \tl_put_right:Ne \l__pv_key_join_tl { \__pv_kw_sep: } }
            \tl_put_right:Nn \l__pv_key_join_tl {##1}
          }
      }
    \tl_put_right:NV \l__pv_key_line_tl \l__pv_key_join_tl
  }
\cs_generate_variant:Nn \__pv_key_join:nnn { VVV }
% The words for the paper's own method, set in the style its name has.
\cs_new_protected:Npn \__pv_key_ours:n #1
  { \group_begin: \l__pv_ours_style_tl #1 \group_end: }
\cs_new_protected:Npn \__pv_key_heat_line:
  {
    \tl_set:Ne \l__pv_key_line_tl
      {
        \str_if_eq:VnTF \l__pv_heat_tl { table }
          { \exp_not:V \l__pv_kw_heat_table_tl }
          {
            \str_if_eq:VnTF \l__pv_by_tl { column }
              { \exp_not:V \l__pv_kw_heat_column_tl } { \exp_not:V \l__pv_kw_heat_row_tl }
          }
        \exp_not:V \l__pv_kw_colon_tl \__pv_kw_sep:
        \exp_not:V \l__pv_kw_worse_tl \c_space_tl
        \exp_not:N \__pv_key_ramp: \c_space_tl \exp_not:V \l__pv_kw_better_tl
      }
    \seq_put_right:NV \l__pv_key_lines_seq \l__pv_key_line_tl
  }

% ======================================================================
% Layout file for the Python figures
% ======================================================================

\iow_new:N \g__pv_layout_iow
\tl_new:N \g__pv_body_size_tl
\cs_new:Npn \__pv_in:n #1 { \dim_to_decimal_in_unit:nn {#1} { 1in } }
% The body font size is known at \begin{document}. Column widths are taken
% when the first page is shipped out: some classes (acmart sigconf, for one)
% switch to two columns only at \maketitle.
\AddToHook { begindocument / end }
  {
    \tl_gset:Ne \g__pv_body_size_tl { \f@size }
    \bool_if:NT \g__pv_layout_bool
      { \AddToHookNext { shipout / before } { \__pv_write_layout: } }
  }
\str_new:N \l__pv_json_str
\str_new:N \l__pv_json_better_str
\str_new:N \l__pv_json_worse_str
\cs_generate_variant:Nn \str_replace_all:Nnn { Nee }
% #1: a word variable, as a JSON string with quotes and backslashes escaped.
\cs_new_protected:Npn \__pv_json_word:N #1
  {
    \str_set:Ne \l__pv_json_str { \tl_to_str:N #1 }
    \str_replace_all:Nee \l__pv_json_str { \c_backslash_str } { \c_backslash_str \c_backslash_str }
    \str_replace_all:Nee \l__pv_json_str { \tl_to_str:n { " } } { \c_backslash_str \tl_to_str:n { " } }
  }
\cs_new_protected:Npn \__pv_write_layout:
  {
    \__pv_json_word:N \l__pv_kw_better_tl
    \str_set_eq:NN \l__pv_json_better_str \l__pv_json_str
    \__pv_json_word:N \l__pv_kw_worse_tl
    \str_set_eq:NN \l__pv_json_worse_str \l__pv_json_str
    \__pv_json_word:N \l__pv_kw_crosses_tl
    \iow_open:Nn \g__pv_layout_iow { \c_sys_jobname_str .pubviz.json }
    \iow_now:Ne \g__pv_layout_iow
      {
        \c_left_brace_str
        "columnwidth_in":~\__pv_in:n { \columnwidth } ,~
        "textwidth_in":~\__pv_in:n { \textwidth } ,~
        "font_size_pt":~\g__pv_body_size_tl ,~
        "twocolumn":~\if@twocolumn true \else false \fi ,~
        "rmfamily":~"\rmdefault" ,~
        "sffamily":~"\sfdefault" ,~
        "familydefault":~"\familydefault" ,~
        "accent":~"\c_hash_str\l__pv_accent_tl" ,~
        "pos":~"\c_hash_str\l__pv_pos_tl" ,~
        "neg":~"\c_hash_str\l__pv_neg_tl" ,~
        "mode":~"\l__pv_mode_tl" ,~
        "language":~"\l__pv_language_tl" ,~
        "words":~\c_left_brace_str
          "better":~"\l__pv_json_better_str" ,~
          "worse":~"\l__pv_json_worse_str" ,~
          "crosses_zero":~"\l__pv_json_str"
        \c_right_brace_str
        \c_right_brace_str
      }
    \iow_close:N \g__pv_layout_iow
  }

% ======================================================================
% Diagrams: \usepackage[diagrams]{pubviz}
% ======================================================================
% TikZ styles for method and architecture diagrams, in the colors and print
% modes of the tables. A block is filled by role (default: only the new part
% takes the accent) or, with "pv kinds", by kind (one light fill per kind of
% block). Text stays dark on light fills in every case.

\bool_if:NF \g__pv_diagrams_bool { \file_input_stop: }

\cs_generate_variant:Nn \msg_warning:nnn { nne }
\bool_new:N \l__pv_kinds_bool
\box_new:N \l__pv_diagram_box
\cs_new:Npn \pv@dfont { \l__pv_dfont_tl }
\cs_new:Npn \pv@dnote { \l__pv_dnote_tl }
\cs_new_protected:Npn \pv@kinds #1
  { \bool_set:Nn \l__pv_kinds_bool { \str_if_eq_p:nn {#1} { true } } }
% Fills are dropped in plain mode, as in the tables.
\cs_new_protected:Npn \pv@fill #1
  { \str_if_eq:VnF \l__pv_mode_tl { plain } { \pgfkeysalso { fill = #1 } } }
\cs_new_protected:Npn \pv@kind #1
  { \bool_if:NT \l__pv_kinds_bool { \pv@fill { pv-kind-#1 } } }
% The new part: accent fill (by role) or a thick accent border (by kind),
% always with a bold label so it reads without color.
\cs_new_protected:Npn \pv@new
  {
    \str_if_eq:VnTF \l__pv_mode_tl { plain }
      { \pgfkeysalso { line~width = 1.3pt } }
      {
        \bool_if:NTF \l__pv_kinds_bool
          { \pgfkeysalso { draw = pv-strong , line~width = 1.3pt } }
          { \pgfkeysalso { fill = pv-fill-1 } }
      }
    \pgfkeysalso { font = \pv@dfont \bfseries }
  }

% A diagram drawn at its printed size. It warns when it is wider than the
% line instead of letting anything scale it down.
\NewDocumentEnvironment { pvdiagram } { O{} }
  {
    \hbox_set:Nw \l__pv_diagram_box
    \begin{tikzpicture} [ pv~diagram , #1 ]
  }
  {
    \end{tikzpicture}
    \hbox_set_end:
    \dim_compare:nNnT { \box_wd:N \l__pv_diagram_box } > { \linewidth + 0.5pt }
      {
        \msg_warning:nne { pubviz } { diagram-too-wide }
          {
            \fp_eval:n
              { round ( \dim_to_fp:n { \box_wd:N \l__pv_diagram_box - \linewidth } , 1 ) }
          }
      }
    \mode_leave_vertical:
    \box_use:N \l__pv_diagram_box
  }

