\RequirePackage{tikz}
\usetikzlibrary{positioning,fit,backgrounds,arrows.meta,calc}
\definecolor{pv-ink}{HTML}{1A1A1A}
\definecolor{pv-line}{HTML}{3A3A3A}
\tikzset{
  pv diagram/.style={
    font=\pv@dfont, color=pv-line, text=pv-ink, line width=0.6pt,
    line cap=round, line join=round, >={Stealth[length=4pt, width=3.6pt]},
    node distance=4mm and 5mm,
  },
  % Fill blocks by kind instead of by role.
  pv kinds/.code={\pv@kinds{#1}}, pv kinds/.default=true,
  pv block/.style={
    draw=pv-line, fill=white, rounded corners=2.5pt, align=center,
    inner xsep=4pt, inner ysep=3pt, minimum height=1.6em,
  },
  pv kind/.code={\pv@kind{#1}},
  % A fill that plain mode drops.
  pv fill/.code={\pv@fill{#1}},
  pv new/.code={\pv@new},
  % A box around blocks that belong together, such as a repeated layer.
  pv group/.style={draw=pv-line, rounded corners=6pt, pv fill=pv-band},
  % An operation: a circle with a plus (add), or a wave (positional encoding).
  pv op/.style={
    circle, draw=pv-line, fill=white, minimum size=1em, inner sep=0pt,
    path picture={\draw[pv-line, line width=0.6pt]
      (path picture bounding box.north) -- (path picture bounding box.south)
      (path picture bounding box.west) -- (path picture bounding box.east);},
  },
  pv wave/.style={
    circle, draw=pv-line, fill=white, minimum size=1.7em, inner sep=0pt,
    path picture={\draw[pv-line, line width=0.6pt, shift={(path picture bounding box.center)}]
      plot[domain=-1:1, samples=31, smooth] ({\x*0.55em}, {0.27em*sin(180*\x)});},
  },
  pv flow/.style={draw=pv-line, ->, rounded corners=4pt},
  pv line/.style={draw=pv-line, rounded corners=4pt},
  pv label/.style={align=center, inner sep=1pt},
  % Small grey text on an edge: a tensor shape, a loss, a count.
  pv note/.style={font=\pv@dnote, text=pv-muted, align=center, inner sep=1pt},
  % ---- a lighter style for flows between stages ----
  % A thin grey link with an open arrowhead; corners are rounded, so a path
  % that branches (a bus) reads as one line.
  pv link/.style={draw=pv-muted, rounded corners=6pt, line width=0.55pt,
    -{Straight Barb[length=2.8pt, width=5.6pt, line width=0.55pt]}},
  % A region behind the parts that belong together, such as blocks that
  % repeat: a light fill and no border (a dotted border in plain mode).
  % pv region=pv-fill-3 tints it with the accent, for the part the paper adds.
  pv region/.code={\pv@region{#1}}, pv region/.default=pv-band,
  % A stage title above a block; add a grey second line with \pvnote{...}.
  pv title/.style={align=center, inner sep=1pt, font=\pv@dfont},
  % The part the paper adds: in the accent on color pages; in grey and plain
  % print, where the accent's grey would be lighter than the rest, in near
  % black with a heavier line. For edges, their labels and stacks.
  pv emph/.code={\pv@emph},
  % A stack of layers drawn as a small picture instead of a labelled box.
  % It is a node, so positioning (right=of) and anchors (.east) work;
  % pv layers sets how many layers it shows.
  pv stack/.style={rectangle, inner sep=0pt, fill=none, draw opacity=0,
    minimum width=2*\pv@stackw+1.2pt,
    minimum height=2*\pv@stackh+(\pv@layers-1)*\pv@stackgap+1.2pt,
    path picture={\pv@drawstack}},
  pv layers/.store in=\pv@layers, pv layers=6,
  pv stack ink/.store in=\pv@stackink, pv stack ink=pv-line,
  pv stack line/.store in=\pv@stackline, pv stack line=0.6pt,
}
\def\pv@stackw{6.4mm}
\def\pv@stackh{3.1mm}
\def\pv@stackgap{0.85mm}
% Layers from the bottom up, each filled white so the one above covers it.
% Path pictures ignore shifts, so each layer's center is computed instead.
\def\pv@drawstack{%
  \foreach \pv@i in {1,...,\pv@layers}{%
    \coordinate (pv@layer) at ($(path picture bounding box.north)
      +(0,{-0.6pt-\pv@stackh-(\pv@layers-\pv@i)*\pv@stackgap})$);
    \filldraw[fill=white, draw=\pv@stackink, draw opacity=1, line width=\pv@stackline, line join=round]
      (pv@layer) ++(-\pv@stackw,0) -- ++(\pv@stackw,\pv@stackh) -- ++(\pv@stackw,-\pv@stackh)
      -- ++(-\pv@stackw,-\pv@stackh) -- cycle;}}
% A small grey second line under a title: \pvnote{runs once}.
\newcommand\pvnote[1]{{\pv@dnote\color{pv-muted}#1}}
% A loop sign for a part that runs more than once: \pvrepeat\ run 3 times.
\newcommand\pvrepeat{\tikz[baseline=-0.6ex, line width=0.5pt, line cap=round]
  \draw[-{Straight Barb[length=1.3pt, width=2.8pt, line width=0.5pt]}]
    (0.45em,0) arc[start angle=0, end angle=290, radius=0.45em];}
\ExplSyntaxOn
\cs_new_protected:Npn \pv@emph
  {
    \str_if_eq:VnTF \l__pv_mode_tl { color }
      { \pgfkeysalso { draw = pv-strong , text = pv-strong , pv~stack~ink = pv-strong } }
      {
        \pgfkeysalso
          { draw = pv-ink , text = pv-ink , line~width = 0.9pt ,
            pv~stack~ink = pv-ink , pv~stack~line = 0.9pt }
      }
  }
% The fill of a region; plain mode has no fills, so it gets a dotted border.
\cs_new_protected:Npn \pv@region #1
  {
    \str_if_eq:VnTF \l__pv_mode_tl { plain }
      { \pgfkeysalso { draw = pv-line , densely~dotted , rounded~corners = 5pt } }
      { \pgfkeysalso { fill = #1 , draw = none , rounded~corners = 5pt } }
  }
