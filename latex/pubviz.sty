% \pvshade{t}{text}: text on a shade of the accent scale, t in [0, 1]
% (1 darkest), for the weight of each token of a sentence. \pvshade*{t}{text}
% takes t in [-1, 1]: a tint of pos for positive weights, a tint of neg with
% a line under it for negative ones, so the sign survives a grey print. In
% mode=plain, or with fill=none, the text stays plain (the line remains).
% pv.pvshade in Python writes a whole sentence of these.
\box_new:N \l__pv_shade_box
\NewDocumentCommand \pvshade { s m m }
  {
    \IfBooleanTF {#1}
      { \__pv_shade_signed:nn {#2} {#3} }
      { \__pv_shade:nn { pv-heat- \fp_eval:n { round ( 8 * max ( 0 , min ( 1 , #2 ) ) ) } } {#3} }
  }
\cs_new_protected:Npn \__pv_shade:nn #1 #2
  {
    \mode_leave_vertical:
    \__pv_fills_on:TF
      {
        \group_begin:
          \dim_set:Nn \fboxsep { 0.6pt }
          \colorbox {#1} { \vphantom { Ag } #2 }
        \group_end:
      }
      { #2 }
  }
\cs_new_protected:Npn \__pv_shade_signed:nn #1 #2
  {
    \fp_compare:nNnTF {#1} < { 0 }
      {
        \mode_leave_vertical:
        \hbox_set:Nn \l__pv_shade_box
          { \__pv_shade:nn { pv-neg ! \fp_eval:n { round ( 45 * min ( 1 , - ( #1 ) ) ) } ! white } {#2} }
        \group_begin:
          \color { pv-neg }
          \hbox_overlap_right:n
            {
              \tex_vrule:D
                width \box_wd:N \l__pv_shade_box
                height \dim_eval:n { - \box_dp:N \l__pv_shade_box - 0.3pt }
                depth \dim_eval:n { \box_dp:N \l__pv_shade_box + 0.8pt }
            }
        \group_end:
        \box_use:N \l__pv_shade_box
      }
      { \__pv_shade:nn { pv-pos ! \fp_eval:n { round ( 45 * min ( 1 , #1 ) ) } ! white } {#2} }
  }

% A signed change. #1: 1 helps, -1 hurts, 0 neither; #2: text with sign.
\cs_new_protected:Npn \__pv_delta_text:nn #1 #2
  {
    \group_begin:
