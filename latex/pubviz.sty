\tl_new:N \l__pv_pos_tl
\tl_new:N \l__pv_neg_tl
\tl_new:N \l__pv_mode_tl
\tl_new:N \l__pv_fill_tl
\tl_new:N \l__pv_by_tl
\tl_new:N \l__pv_better_tl
\tl_new:N \l__pv_delta_tl
\tl_new:N \l__pv_show_tl
\tl_new:N \l__pv_heat_tl
\tl_new:N \l__pv_ties_tl
\tl_new:N \l__pv_header_tl
\tl_new:N \l__pv_align_tl
\tl_new:N \l__pv_underline_tl
\tl_new:N \l__pv_hpad_tl
\tl_new:N \l__pv_vpad_tl
\tl_new:N \l__pv_ours_style_tl
\tl_new:N \l__pv_missing_tl
\tl_new:N \l__pv_delta_size_tl
\tl_new:N \l__pv_stretch_tl
\int_new:N \l__pv_ranks_int
\int_new:N \l__pv_label_cols_int
\int_new:N \l__pv_delta_digits_int
\bool_new:N \l__pv_bold_best_bool
\bool_new:N \l__pv_debug_bool
\bool_new:N \g__pv_layout_bool
\bool_new:N \l__pv_recolor_bool

\keys_define:nn { pubviz }
  {
    % ---- theme
    accent .code:n =
      { \__pv_set_color:Nn \l__pv_accent_tl {#1} \bool_set_true:N \l__pv_recolor_bool },
    theme .choices:nn = { amber, blue, teal, green, red, purple, gray }
      {
        \tl_set:Ne \l__pv_accent_tl { \tl_use:c { c__pv_preset_ #1 _tl } }
        \bool_set_true:N \l__pv_recolor_bool
      },
    pos .code:n =
      { \__pv_set_color:Nn \l__pv_pos_tl {#1} \bool_set_true:N \l__pv_recolor_bool },
    neg .code:n =
      { \__pv_set_color:Nn \l__pv_neg_tl {#1} \bool_set_true:N \l__pv_recolor_bool },
    mode .choices:nn = { color, gray, plain }
      { \tl_set:Ne \l__pv_mode_tl {#1} \bool_set_true:N \l__pv_recolor_bool },
    layout-file .bool_gset:N = \g__pv_layout_bool,
    % ---- how marks look
    fill .choices:nn = { chip, cell, none } { \tl_set:Ne \l__pv_fill_tl {#1} },
    ranks .int_set:N = \l__pv_ranks_int,
    ties .choices:nn = { shared, dense } { \tl_set:Ne \l__pv_ties_tl {#1} },
    bold-best .bool_set:N = \l__pv_bold_best_bool,
    underline-second .choices:nn = { auto, true, false }
      { \tl_set:Ne \l__pv_underline_tl {#1} },
    align .choices:nn = { l, c, r } { \tl_set:Ne \l__pv_align_tl {#1} },
    chip-hpad .tl_set:N = \l__pv_hpad_tl,
    chip-vpad .tl_set:N = \l__pv_vpad_tl,
    ours-style .tl_set:N = \l__pv_ours_style_tl,
    missing .tl_set:N = \l__pv_missing_tl,
    delta-size .tl_set:N = \l__pv_delta_size_tl,
    stretch .tl_set:N = \l__pv_stretch_tl,
    debug .bool_set:N = \l__pv_debug_bool,
    % ---- what a table compares
    by .choices:nn = { column, row } { \tl_set:Ne \l__pv_by_tl {#1} },
    better .choices:nn = { higher, lower } { \tl_set:Ne \l__pv_better_tl {#1} },
    header .tl_set:N = \l__pv_header_tl,
    label-cols .int_set:N = \l__pv_label_cols_int,
    delta .choices:nn = { none, absolute, relative } { \tl_set:Ne \l__pv_delta_tl {#1} },
    show .choices:nn = { both, delta } { \tl_set:Ne \l__pv_show_tl {#1} },
    delta-digits .int_set:N = \l__pv_delta_digits_int,
    heat .choices:nn = { none, group, table } { \tl_set:Ne \l__pv_heat_tl {#1} },
    % ---- words of the key under a table (\pvkey)
    language .code:n = { \__pv_language:n {#1} },
    key/best .tl_set:N = \l__pv_key_best_tl,
    key/second .tl_set:N = \l__pv_key_second_tl,
    key/third .tl_set:N = \l__pv_key_third_tl,
    key/missing .tl_set:N = \l__pv_key_missing_tl,
    key/baseline .tl_set:N = \l__pv_key_baseline_tl,
    key/ours .tl_set:N = \l__pv_key_ours_tl,
    % ---- diagrams (TikZ styles, loaded only with this option)
    diagrams .bool_gset:N = \g__pv_diagrams_bool,
    diagrams .usage:n = load,
    diagram-font .choices:nn = { sans, body } { \__pv_diagram_font:n {#1} },
  }

% Diagram text: a little smaller than the body, like figure text; sans by
% default, as in the Python figures, or the body face.
\tl_new:N \l__pv_dfont_tl
\tl_new:N \l__pv_dnote_tl
\cs_new_protected:Npn \__pv_diagram_font:n #1
  {
    \str_if_eq:nnTF {#1} { sans }
      {
        \tl_set:Nn \l__pv_dfont_tl { \sffamily \footnotesize }
        \tl_set:Nn \l__pv_dnote_tl { \sffamily \scriptsize }
      }
      {
        \tl_set:Nn \l__pv_dfont_tl { \footnotesize }
        \tl_set:Nn \l__pv_dnote_tl { \scriptsize }
      }
  }

\tl_const:Nn \c__pv_preset_amber_tl  { E4AE1A }
\tl_const:Nn \c__pv_preset_blue_tl   { 1A73D5 }
\tl_const:Nn \c__pv_preset_teal_tl   { 009A9A }
\tl_const:Nn \c__pv_preset_green_tl  { 2E9E52 }
\tl_const:Nn \c__pv_preset_red_tl    { DA4339 }
\tl_const:Nn \c__pv_preset_purple_tl { 8254C4 }
\tl_const:Nn \c__pv_preset_gray_tl   { 717171 }

% A hex value (with or without #) or any xcolor expression, stored as hex.
\str_new:N \l__pv_color_str
\tl_new:N \l__pv_model_tl
\tl_new:N \l__pv_spec_tl
\cs_new_protected:Npn \__pv_set_color:Nn #1 #2
  {
    \str_set:Ne \l__pv_color_str { \tl_to_str:n {#2} }
    \exp_args:NNV \str_remove_all:Nn \l__pv_color_str \c_hash_str
    \str_remove_all:Nn \l__pv_color_str { ~ }
    \regex_match:nVTF { \A [0-9A-Fa-f]{6} \Z } \l__pv_color_str
      { \tl_set:Ne #1 { \str_uppercase:f { \l__pv_color_str } } }
      {
        \colorlet { pv@probe } {#2}
        \extractcolorspecs { pv@probe } \l__pv_model_tl \l__pv_spec_tl
        \convertcolorspec { \l__pv_model_tl } { \l__pv_spec_tl } { HTML } #1
      }
  }

% Apply options; derive the colors again when a color option changed. Inside
% a group (one table, one key) the new colors last until the group ends.
\cs_new_protected:Npn \__pv_apply:n #1
  {
    \bool_set_false:N \l__pv_recolor_bool
    \keys_set:nn { pubviz } {#1}
    \bool_if:NT \l__pv_recolor_bool { \__pv_derive: }
  }
\cs_generate_variant:Nn \__pv_apply:n { V }
\NewDocumentCommand \pvsetup { m } { \__pv_apply:n {#1} }

% ======================================================================
% Color math. Mirror of src/pubviz/color.py: keep the constants equal.
% ======================================================================

\fp_new:N \l__pv_r_fp
\fp_new:N \l__pv_g_fp
\fp_new:N \l__pv_b_fp
\fp_new:N \l__pv_L_fp
\fp_new:N \l__pv_C_fp
\fp_new:N \l__pv_h_fp
\fp_new:N \l__pv_lo_fp
\fp_new:N \l__pv_hi_fp
\fp_new:N \l__pv_mid_fp
\fp_new:N \l__pv_x_fp
\fp_new:N \l__pv_y_fp
\fp_new:N \l__pv_z_fp
\fp_const:Nn \c__pv_eps_fp { 0.000001 }
\int_const:Nn \c__pv_bisect_int { 18 }
\tl_new:N \l__pv_hex_tl

% l3fp evaluates both branches of ?:, so neither branch may fail.
\cs_new:Npn \__pv_lin:n #1
  { ( (#1) <= 0.04045 ) ? ( (#1) / 12.92 ) : ( ( ( (#1) + 0.055 ) / 1.055 ) ^ 2.4 ) }
\cs_new:Npn \__pv_gam:n #1
  { ( (#1) <= 0.0031308 ) ? ( 12.92 * (#1) ) : ( 1.055 * ( abs (#1) ^ (1/2.4) ) - 0.055 ) }
\cs_new:Npn \__pv_cbrt:n #1
  { ( sign (#1) * ( abs (#1) ^ (1/3) ) ) }
\cs_new:Npn \__pv_hexbyte:Nn #1 #2
  { ( \exp_args:Ne \int_from_hex:n { \str_range:Nnn #1 {#2} { #2 + 1 } } / 255 ) }

% hex -> \l__pv_L_fp, \l__pv_C_fp, \l__pv_h_fp (radians)
\cs_new_protected:Npn \__pv_hex_to_oklch:n #1
  {
    \str_set:Ne \l__pv_color_str {#1}
    \fp_set:Nn \l__pv_r_fp { \__pv_lin:n { \__pv_hexbyte:Nn \l__pv_color_str { 1 } } }
    \fp_set:Nn \l__pv_g_fp { \__pv_lin:n { \__pv_hexbyte:Nn \l__pv_color_str { 3 } } }
    \fp_set:Nn \l__pv_b_fp { \__pv_lin:n { \__pv_hexbyte:Nn \l__pv_color_str { 5 } } }
    \fp_set:Nn \l__pv_x_fp
      {
        \__pv_cbrt:n
          { 0.4122214708 * \l__pv_r_fp + 0.5363325363 * \l__pv_g_fp + 0.0514459929 * \l__pv_b_fp }
      }
    \fp_set:Nn \l__pv_y_fp
      {
        \__pv_cbrt:n
          { 0.2119034982 * \l__pv_r_fp + 0.6806995451 * \l__pv_g_fp + 0.1073969566 * \l__pv_b_fp }
      }
    \fp_set:Nn \l__pv_z_fp
      {
        \__pv_cbrt:n
          { 0.0883024619 * \l__pv_r_fp + 0.2817188376 * \l__pv_g_fp + 0.6299787005 * \l__pv_b_fp }
      }
    \fp_set:Nn \l__pv_L_fp
      { 0.2104542553 * \l__pv_x_fp + 0.7936177850 * \l__pv_y_fp - 0.0040720468 * \l__pv_z_fp }
    \fp_set:Nn \l__pv_lo_fp
      { 1.9779984951 * \l__pv_x_fp - 2.4285922050 * \l__pv_y_fp + 0.4505937099 * \l__pv_z_fp }
    \fp_set:Nn \l__pv_hi_fp
      { 0.0259040371 * \l__pv_x_fp + 0.7827717662 * \l__pv_y_fp - 0.8086757660 * \l__pv_z_fp }
    \fp_set:Nn \l__pv_C_fp { sqrt ( \l__pv_lo_fp ^ 2 + \l__pv_hi_fp ^ 2 ) }
    \fp_compare:nNnTF \l__pv_C_fp > { 0.000001 }
      { \fp_set:Nn \l__pv_h_fp { atan ( \l__pv_hi_fp , \l__pv_lo_fp ) } }
      { \fp_set:Nn \l__pv_h_fp { 0 } }
  }

% (L, C, h) -> linear sRGB in \l__pv_r_fp, \l__pv_g_fp, \l__pv_b_fp
\cs_new_protected:Npn \__pv_oklch_to_lin:nnn #1 #2 #3
  {
    \fp_set:Nn \l__pv_lo_fp { (#2) * cos (#3) }
    \fp_set:Nn \l__pv_hi_fp { (#2) * sin (#3) }
    \fp_set:Nn \l__pv_x_fp
      { ( (#1) + 0.3963377774 * \l__pv_lo_fp + 0.2158037573 * \l__pv_hi_fp ) ^ 3 }
    \fp_set:Nn \l__pv_y_fp
      { ( (#1) - 0.1055613458 * \l__pv_lo_fp - 0.0638541728 * \l__pv_hi_fp ) ^ 3 }
    \fp_set:Nn \l__pv_z_fp
      { ( (#1) - 0.0894841775 * \l__pv_lo_fp - 1.2914855480 * \l__pv_hi_fp ) ^ 3 }
    \fp_set:Nn \l__pv_r_fp
      {  4.0767416621 * \l__pv_x_fp - 3.3077115913 * \l__pv_y_fp + 0.2309699292 * \l__pv_z_fp }
    \fp_set:Nn \l__pv_g_fp
      { -1.2684380046 * \l__pv_x_fp + 2.6097574011 * \l__pv_y_fp - 0.3413193965 * \l__pv_z_fp }
    \fp_set:Nn \l__pv_b_fp
      { -0.0041960863 * \l__pv_x_fp - 0.7034186147 * \l__pv_y_fp + 1.7076147010 * \l__pv_z_fp }
  }

\cs_new:Npn \__pv_in_range:N #1
  { ( #1 >= - \c__pv_eps_fp ) && ( #1 <= 1 + \c__pv_eps_fp ) }
\prg_new_protected_conditional:Npnn \__pv_in_gamut:nnn #1 #2 #3 { TF }
  {
    \__pv_oklch_to_lin:nnn {#1} {#2} {#3}
    \fp_compare:nTF
      {
        \__pv_in_range:N \l__pv_r_fp && \__pv_in_range:N \l__pv_g_fp
        && \__pv_in_range:N \l__pv_b_fp
      }
      { \prg_return_true: } { \prg_return_false: }
  }

\fp_new:N \l__pv_tL_fp
\fp_new:N \l__pv_tC_fp
\fp_new:N \l__pv_th_fp
\fp_new:N \l__pv_bis_lo_fp
\fp_new:N \l__pv_bis_hi_fp
% (L, C, h) -> \l__pv_hex_tl, lowering chroma until sRGB can show the color.
\cs_new_protected:Npn \__pv_oklch_to_hex:nnn #1 #2 #3
  {
    \fp_set:Nn \l__pv_tL_fp {#1}
    \fp_set:Nn \l__pv_tC_fp {#2}
    \fp_set:Nn \l__pv_th_fp {#3}
    \__pv_in_gamut:nnnTF \l__pv_tL_fp \l__pv_tC_fp \l__pv_th_fp
      { }
      {
        \fp_set:Nn \l__pv_bis_lo_fp { 0 }
        \fp_set_eq:NN \l__pv_bis_hi_fp \l__pv_tC_fp
        \prg_replicate:nn { \c__pv_bisect_int }
          {
            \fp_set:Nn \l__pv_mid_fp { ( \l__pv_bis_lo_fp + \l__pv_bis_hi_fp ) / 2 }
            \__pv_in_gamut:nnnTF \l__pv_tL_fp \l__pv_mid_fp \l__pv_th_fp
              { \fp_set_eq:NN \l__pv_bis_lo_fp \l__pv_mid_fp }
              { \fp_set_eq:NN \l__pv_bis_hi_fp \l__pv_mid_fp }
          }
        \fp_set_eq:NN \l__pv_tC_fp \l__pv_bis_lo_fp
      }
    \__pv_oklch_to_lin:nnn \l__pv_tL_fp \l__pv_tC_fp \l__pv_th_fp
    \tl_set:Ne \l__pv_hex_tl
      {
        \__pv_byte_hex:n { \__pv_gam:n { \l__pv_r_fp } }
        \__pv_byte_hex:n { \__pv_gam:n { \l__pv_g_fp } }
        \__pv_byte_hex:n { \__pv_gam:n { \l__pv_b_fp } }
      }
  }
\cs_new:Npn \__pv_byte_hex:n #1
  {
    \exp_args:Ne \__pv_byte_hex_aux:n
      { \fp_eval:n { trunc ( 255 * max ( 0 , min ( 1 , #1 ) ) + 0.5 ) } }
  }
\cs_new:Npn \__pv_byte_hex_aux:n #1
  { \int_compare:nNnT {#1} < { 16 } { 0 } \int_to_Hex:n {#1} }

% ======================================================================
% Theme roles. Mirror of derive_roles in src/pubviz/theme.py.
% ======================================================================

\fp_new:N \l__pv_aL_fp
\fp_new:N \l__pv_aC_fp
\fp_new:N \l__pv_ah_fp
\tl_new:N \l__pv_role_tl

% Define color pv-<name> from (L, C, h).
\cs_new_protected:Npn \__pv_role:nnnn #1 #2 #3 #4
  {
    \__pv_oklch_to_hex:nnn {#2} {#3} {#4}
    \__pv_role_hex:nV {#1} \l__pv_hex_tl
  }
% Define color pv-<name> from a hex value; gray and plain modes keep only
% the lightness.
\cs_new_protected:Npn \__pv_role_hex:nn #1 #2
  {
    \str_if_eq:VnTF \l__pv_mode_tl { color }
      { \tl_set:Ne \l__pv_role_tl {#2} }
      {
        \__pv_hex_to_oklch:n {#2}
        \__pv_oklch_to_hex:nnn \l__pv_L_fp { 0 } { 0 }
        \tl_set_eq:NN \l__pv_role_tl \l__pv_hex_tl
      }
    \definecolor { pv-#1 } { HTML } { \l__pv_role_tl }
    \tl_clear_new:c { l__pv_role_ #1 _tl }
    \tl_set_eq:cN { l__pv_role_ #1 _tl } \l__pv_role_tl
  }
\cs_generate_variant:Nn \__pv_role_hex:nn { nV }

\cs_new_protected:Npn \__pv_derive:
  {
    \__pv_hex_to_oklch:n { \l__pv_accent_tl }
    \fp_set_eq:NN \l__pv_aL_fp \l__pv_L_fp
    \fp_set_eq:NN \l__pv_aC_fp \l__pv_C_fp
    \fp_set_eq:NN \l__pv_ah_fp \l__pv_h_fp
    \__pv_role_hex:nV { accent } \l__pv_accent_tl
    \__pv_role:nnnn { strong }
      { max ( 0.42 , min ( 0.66 , \l__pv_aL_fp ) ) } { \l__pv_aC_fp } { \l__pv_ah_fp }
    % The best fill at 0.85 stays about 10 lightness points from the second in
    % grey for every preset accent, with black text above a contrast of 12.
    \__pv_role:nnnn { fill-1 } { 0.850 } { 0.65 * \l__pv_aC_fp } { \l__pv_ah_fp }
    \__pv_role:nnnn { fill-2 } { 0.955 } { 0.26 * \l__pv_aC_fp } { \l__pv_ah_fp }
    \__pv_role:nnnn { fill-3 } { 0.978 } { 0.12 * \l__pv_aC_fp } { \l__pv_ah_fp }
    \__pv_role:nnnn { band } { 0.960 } { 0 } { 0 }
    \__pv_role:nnnn { muted } { 0.550 } { 0 } { 0 }
    \__pv_role_hex:nV { pos } \l__pv_pos_tl
    \__pv_role_hex:nV { neg } \l__pv_neg_tl
    \int_step_inline:nnn { 0 } { 8 }
      {
        \__pv_role:nnnn { heat-##1 }
          { 0.975 + ( 0.780 - 0.975 ) * ##1 / 8 }
          { 0.80 * \l__pv_aC_fp * ##1 / 8 }
          { \l__pv_ah_fp }
      }
    % Kinds of block in a diagram, one light fill per kind at the same
    % lightness: the label names the kind, the fill only helps the eye group
    % blocks of one kind. Fixed hues, so a kind keeps its color across papers.
    \__pv_role:nnnn { kind-1 } { 0.920 } { 0.070 } { 55 deg }    % orange
    \__pv_role:nnnn { kind-2 } { 0.920 } { 0.070 } { 250 deg }   % blue
    \__pv_role:nnnn { kind-3 } { 0.920 } { 0.070 } { 105 deg }   % yellow
    \__pv_role:nnnn { kind-4 } { 0.920 } { 0.070 } { 355 deg }   % pink
    \__pv_role:nnnn { kind-5 } { 0.920 } { 0.070 } { 300 deg }   % purple
    \__pv_role:nnnn { kind-6 } { 0.920 } { 0.070 } { 150 deg }   % green
    \bool_if:NT \l__pv_debug_bool { \__pv_log_roles: }
  }
\clist_const:Nn \c__pv_roles_clist
  {
    accent, strong, fill-1, fill-2, fill-3, band, muted, pos, neg,
    heat-0, heat-1, heat-2, heat-3, heat-4, heat-5, heat-6, heat-7, heat-8,
